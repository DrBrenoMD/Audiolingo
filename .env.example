# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GROQ_API_KEY (RECOMENDADO PARA TRANSCRIÇÃO - LIMITE GRATUITO ENORME):
# Chave gratuita da Groq (obtenha gratuitamente em https://console.groq.com sem cartão de crédito).
# - Limite gratuito extraordinário: 8 HORAS DE ÁUDIO POR DIA (28.800 seg/dia) e 2.000 requisições/dia.
# - Utiliza o modelo OpenAI Whisper Large v3 Turbo na nuvem LPU ultra-rápida (resposta < 0.5s).
# - Fornece timestamps nativos exatos por palavra (word-level timestamps) e divisão perfeita de frases.
# - No deploy da Vercel: adicione em Project Settings > Environment Variables como GROQ_API_KEY.
GROQ_API_KEY=""

# GEMINI_API_KEY (FALLBACK / SEGUNDA OPÇÃO DE IA):
# Chave gratuita da API Google Gemini (obtida gratuitamente em https://aistudio.google.com).
# - Utiliza os modelos gratuitos gemini-3.5-transcribe e gemini-3.8-flash.
# - Se GROQ_API_KEY estiver configurada, o Groq Whisper será o motor principal e o Gemini servirá como contingência.
GEMINI_API_KEY=""
